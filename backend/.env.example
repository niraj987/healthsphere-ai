# Copy this file to backend/.env and fill in real values. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql://healthuser:healthpass@postgres-db:5432/healthspheredb

# --- RAG Chatbot LLM (used in app/chatbot/rag_pipeline.py) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Vector store (ChromaDB service in docker-compose.yml) ---
VECTOR_STORE_HOST=vector-store
VECTOR_STORE_PORT=8001

# --- Redis (agent task queue / chat session cache) ---
REDIS_URL=redis://redis-cache:6379/0

# --- Medicine / drug-information APIs (both free, no key required) ---
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json

# --- Notifications (Twilio, optional — leave blank to log reminders instead of sending SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
